#:kivy 2.0.0

<WorkflowAppLayout>:
    csv_path_input: _csv_path_input
    handbook_checkbox: _handbook_checkbox
    handbook_path_input: _handbook_path_input
    output_dir_input: _output_dir_input
    save_to_input: _save_to_input
    learner_profile_preview: _learner_profile_preview
    status_label: _status_label
    progress_bar: _progress_bar
    output_display: _output_display

    orientation: 'vertical'
    padding: 20
    spacing: 15
    background_color: 0.1, 0.1, 0.1, 1

    canvas.before:
        Color:
            rgba: self.background_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: 0.1
        Label:
            text: "Content Generation Workflow"
            font_size: '24sp'
            bold: True
            color: 0.9, 0.9, 0.9, 1

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: 0.8
        spacing: 15

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.35
            spacing: 10
            padding: 10
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10,]

            Label:
                text: "Input & Controls"
                size_hint_y: None
                height: '30dp'
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1

            TextInput:
                id: _csv_path_input
                hint_text: "Select CSV file path"
                multiline: False
                readonly: True
                size_hint_y: None
                height: '40dp'
                background_normal: ''
                background_active: ''
                background_color: 0.95, 0.95, 0.95, 1
                foreground_color: 0, 0, 0, 1
                cursor_color: 0, 0, 0, 1
                font_size: '14sp'
                padding: [10, 10]
                border: [8,8,8,8]
                radius: [5,]

            Button:
                text: "Load CSV"
                size_hint_y: None
                height: '48dp'
                on_release: root.show_file_chooser()
                background_normal: ''
                background_color: 0.25, 0.65, 0.85, 1
                color: 1, 1, 1, 1
                font_size: '16sp'
                bold: True
                radius: [8,]

            Button:
                id: _start_button
                text: "Start Workflow"
                size_hint_y: None
                height: '48dp'
                on_release: root.start_workflow()
                background_normal: ''
                background_color: 0.3, 0.8, 0.4, 1
                color: 1, 1, 1, 1
                font_size: '16sp'
                bold: True
                radius: [8,]

            Label:
                text: "Workflow Status"
                size_hint_y: None
                height: '30dp'
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1

            Label:
                id: _status_label
                text: root.current_stage_name
                size_hint_y: None
                height: '30dp'
                font_size: '16sp'
                color: 1, 1, 1, 1

            ProgressBar:
                id: _progress_bar
                max: 100
                value: root.current_progress_value
                size_hint_y: None
                height: '20dp'
                background_color: 0.3, 0.3, 0.3, 1
                foreground_color: 0.2, 0.7, 0.3, 1

            Label:
                text: "Reference Handbook Integration"
                size_hint_y: None
                height: '30dp'
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: '30dp'
                spacing: 10
                CheckBox:
                    id: _handbook_checkbox
                    size_hint_x: None
                    width: '30dp'
                    color: 0.2, 0.7, 0.3, 1
                    on_active: root.update_handbook_usage(self.active)
                Label:
                    text: "Pull relevant information from reference handbook before generation."
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'middle'
                    color: 0.9, 0.9, 0.9, 1

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: '40dp'
                spacing: 10
                TextInput:
                    id: _handbook_path_input
                    hint_text: "Reference Handbook File"
                    multiline: False
                    readonly: True
                    background_normal: ''
                    background_active: ''
                    background_color: 0.95, 0.95, 0.95, 1
                    foreground_color: 0, 0, 0, 1
                    cursor_color: 0, 0, 0, 1
                    font_size: '14sp'
                    padding: [10, 10]
                    border: [8,8,8,8]
                    radius: [5,]
                Button:
                    text: "Browse..."
                    size_hint_x: None
                    width: '90dp'
                    background_normal: ''
                    background_color: 0.25, 0.65, 0.85, 1
                    color: 1, 1, 1, 1
                    font_size: '14sp'
                    radius: [8,]
                    on_release: root.show_handbook_chooser()

            Label:
                text: "Output Settings"
                size_hint_y: None
                height: '30dp'
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: '40dp'
                spacing: 10
                TextInput:
                    id: _output_dir_input
                    hint_text: "Output Directory"
                    multiline: False
                    readonly: True
                    background_normal: ''
                    background_active: ''
                    background_color: 0.95, 0.95, 0.95, 1
                    foreground_color: 0, 0, 0, 1
                    cursor_color: 0, 0, 0, 1
                    font_size: '14sp'
                    padding: [10, 10]
                    border: [8,8,8,8]
                    radius: [5,]
                Button:
                    text: "Browse..."
                    size_hint_x: None
                    width: '90dp'
                    background_normal: ''
                    background_color: 0.25, 0.65, 0.85, 1
                    color: 1, 1, 1, 1
                    font_size: '14sp'
                    radius: [8,]
                    on_release: root.show_output_dir_chooser()

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: '40dp'
                spacing: 10
                TextInput:
                    id: _save_to_input
                    hint_text: "Save Generated Content To"
                    multiline: False
                    readonly: True
                    background_normal: ''
                    background_active: ''
                    background_color: 0.95, 0.95, 0.95, 1
                    foreground_color: 0, 0, 0, 1
                    cursor_color: 0, 0, 0, 1
                    font_size: '14sp'
                    padding: [10, 10]
                    border: [8,8,8,8]
                    radius: [5,]
                Button:
                    text: "Browse..."
                    size_hint_x: None
                    width: '90dp'
                    background_normal: ''
                    background_color: 0.25, 0.65, 0.85, 1
                    color: 1, 1, 1, 1
                    font_size: '14sp'
                    radius: [8,]
                    on_release: root.show_save_to_chooser()

            Label:
                text: "Learner Profile Preview"
                size_hint_y: None
                height: '30dp'
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1

            TextInput:
                id: _learner_profile_preview
                text: ''
                readonly: True
                size_hint_y: None
                height: '100dp'
                background_normal: ''
                background_active: ''
                background_color: 0.95, 0.95, 0.95, 1
                foreground_color: 0, 0, 0, 1
                font_size: '14sp'
                padding: [10, 10]
                cursor_color: 0, 0, 0, 1
                border: [8,8,8,8]
                radius: [5,]

            Widget:
                size_hint_y: 1

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.65
            spacing: 10
            padding: 10
            canvas.before:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10,]

            Label:
                text: "Output & Results"
                size_hint_y: None
                height: '30dp'
                font_size: '18sp'
                bold: True
                color: 1, 1, 1, 1

            BoxLayout:
                size_hint_y: None
                height: '48dp'
                spacing: 10
                Button:
                    text: "Final Content"
                    on_release: root.view_final_content()
                    background_normal: ''
                    background_color: 0.1, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: '14sp'
                    radius: [8,]
                Button:
                    text: "Initial Plan"
                    on_release: root.view_initial_plan()
                    background_normal: ''
                    background_color: 0.1, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: '14sp'
                    radius: [8,]
                Button:
                    text: "AI Flags"
                    on_release: root.view_ai_flags()
                    background_normal: ''
                    background_color: 0.1, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: '14sp'
                    radius: [8,]

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True
                canvas.before:
                    Color:
                        rgba: 0.3, 0.3, 0.3, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [5,]

                TextInput:
                    id: _output_display
                    text: "Workflow output will appear here. Click 'Start Workflow' after loading a CSV."
                    readonly: True
                    font_size: '14sp'
                    background_color: 0, 0, 0, 0
                    foreground_color: 0.9, 0.9, 0.9, 1
                    padding: [10, 10]
                    size_hint_y: None
                    height: max(self.minimum_height, dp(200))
                    cursor_color: 0,0,0,0
                    selection_color: 0.1, 0.5, 0.7, 0.5

